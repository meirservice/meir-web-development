# ============================================================
# Meir Web Development Services — environment variables
# Copy this file to ".env" and fill it in. Never commit .env.
# ============================================================

# ---------- Business ----------
BUSINESS_NAME=Meir Web Development Services
# New-booking alerts are sent here
OWNER_EMAIL=meirwebdevelopment@gmail.com
SITE_URL=https://meirwebdevelopment.com
BUSINESS_TIMEZONE=Asia/Manila
BUSINESS_TIMEZONE_LABEL=Philippine Time, UTC+8
# Bookable times (in the business timezone), comma-separated
TIME_SLOTS=8:00 AM,9:30 AM,11:00 AM,1:00 PM,2:30 PM,4:00 PM,5:30 PM,7:00 PM
# 0=Mon … 6=Sun, comma-separated. 6 = closed Sundays. Empty = open every day
CLOSED_WEEKDAYS=6
OPEN_HOUR=8
CLOSE_HOUR=20
BOOKING_WINDOW_DAYS=60
MEETING_LENGTH_MIN=30

# ---------- Google Sheets ----------
# The long ID in your sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Bookings
# Local: put the downloaded key next to app.py with this name
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Hosting (Render etc.): paste the WHOLE key JSON on one line instead
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Email ----------
# "smtp" (Gmail, Outlook, SendGrid SMTP, Brevo…) or "resend"
EMAIL_PROVIDER=smtp
EMAIL_FROM=Meir Web Development <meirwebdevelopment@gmail.com>
EMAIL_REPLY_TO=meirwebdevelopment@gmail.com

# Gmail: SMTP_PASSWORD is a 16-character App Password, NOT your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=meirwebdevelopment@gmail.com
SMTP_PASSWORD=

# Only if EMAIL_PROVIDER=resend (EMAIL_FROM must use a domain verified in Resend)
RESEND_API_KEY=

# ---------- App ----------
FLASK_DEBUG=false
RATE_LIMIT_PER_HOUR=5
# Only needed if the front-end is hosted on a different domain than this API
ALLOWED_ORIGINS=
